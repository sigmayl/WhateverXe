#pragma once
// Minimal <algorithm> for the command builders. Only the comparisons the
// builders use are provided.

namespace std {

template <typename T>
const T &min(const T &left, const T &right) {
    return right < left ? right : left;
}

template <typename T>
const T &max(const T &left, const T &right) {
    return left < right ? right : left;
}

}
